# =============================================================
# CASTAMOTO — Variables de entorno (ejemplo)
# Copiar este archivo como ".env" y ajustar los valores reales.
# NUNCA subir el archivo ".env" real al repositorio.
# =============================================================

# --- Aplicación ---
APP_NAME=CASTAMOTO
APP_ENV=local
# local | production  -> en production se ocultan detalles internos de errores
APP_URL=http://localhost/proyectos/castamotos
APP_TIMEZONE=America/Bogota

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=castamoto
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Autenticación / JWT ---
JWT_SECRET=
JWT_TTL=3600
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REMEMBER_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# --- Subida de archivos ---
AVATAR_MAX_SIZE_KB=2048
CATALOG_IMAGE_MAX_SIZE_KB=4096

# --- Envío (tarifa provisional, sección 51) ---
SHIPPING_FLAT_RATE=12000
SHIPPING_FREE_THRESHOLD=300000

# --- Correo ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@castamoto.local
MAIL_FROM_NAME=CASTAMOTO

# --- Pagos (se usa a partir de la Fase 7) ---
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# --- Bot de preguntas / Inteligencia artificial (Fase 11) ---
# AI_PROVIDER: "anthropic" o "openai". Vacío = el asistente responde
# "todavía no está disponible" en vez de inventar respuestas.
AI_PROVIDER=
AI_API_KEY=

# --- "Continuar con Google" (inicio de sesión) ---
# Client ID de un OAuth Client ID de tipo "Web application" en Google Cloud
# Console (console.cloud.google.com → APIs & Services → Credentials). Es
# público (se expone al navegador para armar el botón), no un secreto. Vacío
# = el botón no se muestra.
GOOGLE_CLIENT_ID=
AI_MODEL=

# --- Notificaciones push ---
PUSH_PROVIDER=

# --- CORS ---
CORS_ALLOWED_ORIGINS=*

# --- Contacto ---
# Número de WhatsApp del negocio, formato internacional sin "+" ni espacios
# (ej. 573001234567). Si queda vacío, el botón de WhatsApp se oculta en el frontend.
CONTACT_WHATSAPP_NUMBER=

# --- Usuario administrador inicial (solo para el seeder, entorno local) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@castamoto.local
ADMIN_PASSWORD=CambiarEsteClave123!
CONTACT_WHATSAPP_NUMBER=573157790103