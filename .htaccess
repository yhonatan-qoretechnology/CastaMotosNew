Options -Indexes

# Bloquea el acceso HTTP directo a archivos punto (.env, .env.production, .git*,
# etc.). Sin esto, cualquiera puede pedir https://tudominio/.env y leer en texto
# plano credenciales de BD, JWT_SECRET, claves de pago, etc. Va antes que
# cualquier otra regla para que aplique siempre, incluso si mod_rewrite falla.
<FilesMatch "^\.">
    Require all denied
    # Sintaxis Apache 2.2 (algunos hostings cPanel aún la usan); Apache ignora
    # el bloque que no le corresponde a su versión, así que dejar ambos es seguro.
    Order allow,deny
    Deny from all
</FilesMatch>

# Algunos hostings compartidos (cPanel) traen mod_mime mal configurado y
# terminan sirviendo .css/.js con un Content-Type genérico (ej. text/plain) —
# el navegador entonces se niega a aplicar la hoja de estilos o ejecutar el
# script, aunque el archivo se descargue bien (síntoma: "no reconoce CSS/JS").
# Se fuerza el tipo correcto acá para no depender de la config por defecto del
# servidor. (Ver también el <base href> dinámico en cada página de frontend/ —
# si el problema es un 404 en vez de esto, la causa es otra: estructura de
# carpetas distinta a la esperada en el docroot real de cPanel.)
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType application/json .json
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Toda petición api/* (relativa a esta carpeta) se enruta al front controller
    # del backend. Se pasa la ruta completa (con el prefijo "api/") vía querystring
    # __route, así el backend no necesita adivinar el "base path" del despliegue
    # (funciona igual en /proyectos/castamotos/ que en un futuro vhost dedicado).
    RewriteRule ^api/(.*)$ backend/public/index.php?__route=api/$1 [L,QSA]

    # URLs amigables del frontend (sección 31), consistentes con "canonical_url"
    # que ya devuelve la API desde la Fase 4. Van antes que nada más porque son
    # más específicas; no interfieren con /api/* (ya resuelto arriba con [L]).
    RewriteRule ^producto/([^/]+)/?$ frontend/pages/producto.html?slug=$1 [L,QSA]
    RewriteRule ^servicio/([^/]+)/?$ frontend/pages/servicio.html?slug=$1 [L,QSA]
    RewriteRule ^categoria/([^/]+)/?$ frontend/pages/productos.html?category=$1 [L,QSA]
    RewriteRule ^pedido/([^/]+)/?$ frontend/pages/pedido.html?number=$1 [L,QSA]
    RewriteRule ^productos/?$ frontend/pages/productos.html [L,QSA]
    RewriteRule ^servicios/?$ frontend/pages/servicios.html [L,QSA]
    RewriteRule ^carrito/?$ frontend/pages/carrito.html [L,QSA]
    RewriteRule ^checkout/?$ frontend/pages/checkout.html [L,QSA]
    RewriteRule ^recuperar-password/?$ frontend/pages/recuperar-password.html [L,QSA]
    RewriteRule ^favoritos/?$ frontend/pages/favoritos.html [L,QSA]
    RewriteRule ^perfil/?$ frontend/pages/perfil.html [L,QSA]
    RewriteRule ^pedidos/?$ frontend/pages/pedidos.html [L,QSA]
    RewriteRule ^terminos/?$ frontend/pages/terminos.html [L,QSA]
    RewriteRule ^privacidad/?$ frontend/pages/privacidad.html [L,QSA]
    RewriteRule ^lavado/?$ frontend/pages/lavado.html [L,QSA]
    RewriteRule ^admin/?$ frontend/pages/admin.html [L,QSA]
</IfModule>
